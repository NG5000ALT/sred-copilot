# Clerk (dashboard.clerk.com). Organizations on; custom roles org:tech_reviewer, org:cpa
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# SurrealDB. Local single-process dev can use an embedded file: surrealkv://.data/sred
# Web + separate worker need a real server (Surreal Cloud): wss://<host>/rpc
SURREAL_URL=surrealkv://.data/sred
SURREAL_NS=sred
SURREAL_DB=app
SURREAL_USER=
SURREAL_PASS=

ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-5-5
MODEL_MAIN=claude-sonnet-5-5

CONNECTOR=fixture            # era | fixture
ERA_JIRA_MCP_URL=
ERA_SLACK_MCP_URL=
ERA_DOCS_MCP_URL=
ERA_API_KEY=

# true = run the job worker inside the web process (one Render service, embedded DB locally)
RUN_WORKER_IN_WEB=true

AGENT_MEMORY_URL=        # optional
AGENT_MEMORY_KEY=        # optional
